// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String
  notes     Note[]
  folders   Folder[] // ORG-01: User's top-level folders
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  tags      Tag[]    @relation("NoteTags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Fields for AUDIO-01
  audioFilename   String?
  audioTimestamps Json?

  // Field for AI-01
  chatHistory     Json?    // Stores chat messages, e.g., [{"role": "user", "content": "Hi"}, {"role": "model", "content": "Hello"}]

  // ORG-01: Link to a folder
  folderId  String?
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")

  notes     Note[]   // Notes directly within this folder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, parentId, name])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     Note[]   @relation("NoteTags")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
